# Copy this file to .env before starting. Keep .env private: it may contain
# service URLs and later installer-generated secrets.

# Tag of ghcr.io/bertrandom/birdframe to run. `latest` follows master; pin a
# release (e.g. 0.2.0) or a build (e.g. sha-e350162) to stay on one version.
BIRDFRAME_VERSION=latest

# Web UI/API port. With host networking, this is bound directly on the host.
BIRDFRAME_PORT=8765
TZ=Europe/Oslo
PUID=1000
PGID=1000

# Persistent data directory on the Docker host. Create it before first start.
BIRDFRAME_DATA_DIR=./data

# Optional local BirdNET-Go sidecar settings (used only with local-audio).
# Choose a released BirdNET-Go image tag appropriate for your installation.
BIRDNET_GO_IMAGE=ghcr.io/tphakala/birdnet-go:nightly-20260524
BIRDNET_GO_DATA_DIR=./birdnet-go-data
BIRDNET_GO_PORT=8080

# BirdFrame normally reaches the sidecar using this internal Compose URL.
# Do not put provider keys in this file; configure those in the setup wizard.
# Host networking is used by this Compose file, so the sidecar is reached via
# the Linux host loopback interface (not the Compose service DNS name).
BIRDNET_GO_URL=http://127.0.0.1:8080
